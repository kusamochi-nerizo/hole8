  pages:
  - "\u307E\u305F\u3001\u4EBA\u9593\u304C\u3084\u3063\u3066\u304D\u305F\u306E\u304B\u30CB\u30E3...\r\n\u3069\u3046\u3084\u3089\u3001\u304A\u524D\u3082\u30AE\u30E3\u30F3\u30D6\u30EB\u3067\u501F\u91D1\u3092\u80CC\u8CA0\u3044\u3001\n\u3053\u306E\u4E16\u754C\u306B\u8FF7\u3044\u8FBC\u3093\u3060\u53E3\u3089\u3057\u3044\u30CB\u30E3"
  - "\u3053\u3053\u3067\u306F\u4E00\u652B\u5343\u91D1\u304C\u72D9\u3048\u308B\n\u30B2\u30FC\u30E0\u304C\u3067\u304D\u308B\u30CB\u30E3"
  - "\u3053\u308C\u304B\u3089\u6F14\u51FA\u304C\u6D41\u308C\u308B\u30CB\u30E3\n\n\u305D\u306E\u4E2D\u306B\u9055\u548C\u611F\u304C\u3042\u308B\u304B\u3069\u3046\u304B\u5F53\u3066\u308B\u30B2\u30FC\u30E0\u30CB\u30E3"
  - "\u6F14\u51FA\u306E\u4E2D\u306B\u9055\u548C\u611F\u3092\u611F\u3058\u305F\u3089\n\u4E0B\u306B\u3042\u308BPUSH\u30DC\u30BF\u30F3\u3092\u3059\u3050\u62BC\u3059\u30CB\u30E3\r\n"
  - "\u9055\u548C\u611F\u304C\u306A\u3044\u5834\u5408\u3082\u3042\u308B\u30CB\u30E3\n\n\u305D\u306E\u3068\u304D\u306F\u3001\u6700\u5F8C\u307E\u3067\u30DC\u30BF\u30F3\u3092\u62BC\u3055\u305A\u306B\n\u8010\u3048\u629C\u304F\u3053\u3068\u304C\u5FC5\u8981\u3060\u30CB\u30E3"
  - "\u6210\u529F\u3059\u308B\u3054\u3068\u306B1000\u4E07\u305A\u3064\u8FD4\u6E08\u3067\u304D\u308B\u4ED5\u7D44\u307F\u3060\u30CB\u30E3\n\u304A\u524D\u306E\u501F\u91D1\u306F\u3044\u304F\u3089\u30CB\u30E3\uFF1F"
  - "\u2026\u2026\u2026\u2026"
  - "8000\u4E07\uFF01\uFF1F\n\u307E\u305F\u305A\u3044\u3076\u3093\u306A\u984D\u3060\u30CB\u30E3"
  - "\u3068\u3044\u3046\u308F\u3051\u3067\n8\u56DE\u6210\u529F\u3059\u308C\u3070\u5143\u306E\u4E16\u754C\u306B\u5E30\u308C\u308B\u30CB\u30E3"
  - "\u6E96\u5099\u306F\u3044\u3044\u304B\u30CB\u30E3\uFF1F\r\n\u307E\u305A\u306F\u9055\u548C\u611F\u306E\u306A\u3044\u6F14\u51FA\u304B\u3089\u59CB\u307E\u308B\u30CB\u30E3\uFF01"
